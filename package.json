{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:mosaic && next dev",
    "build": "pnpm build:mosaic && next build",
    "start": "next start",
    "lint": "next lint",
    "build:mosaic": "pnpm --filter @apheiro/mosaic build",
    "test:mosaic": "pnpm --filter @apheiro/mosaic test",
    "typecheck": "pnpm build:mosaic && tsc --noEmit",
    "test:browser": "pnpm build:mosaic && playwright test",
    "test:package": "node scripts/verify-mosaic-package.mjs"
  },
  "dependencies": {
    "@apheiro/mosaic": "workspace:*",
    "@mantine/hooks": "^7.12.1",
    "@preact/signals-react": "^2.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tabler/icons-react": "^3.14.0",
    "cva": "1.0.0-beta.1",
    "next": "14.2.6",
    "react": "^18",
    "react-dom": "^18",
    "animejs": "^3.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@unocss/postcss": "^0.62.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5",
    "unocss": "^0.62.3",
    "@types/animejs": "^3.1.12"
  }
}
