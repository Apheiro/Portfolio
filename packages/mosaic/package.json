{
  "name": "@apheiro/mosaic",
  "version": "0.1.0",
  "description": "Animated canvas mosaic with a framework-independent engine and React bindings.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "animejs": "^4.0.2",
    "colord": "^2.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18",
    "react": "^18"
  }
}
